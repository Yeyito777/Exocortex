#!/usr/bin/env bash
# exotest — launch a worktree's daemon + TUI for testing, clean up on exit.
#
# Usage:
#   exotest <worktree>
#
# <worktree> can be:
#   - A bare name:       exotest fix-prompt-scroll
#   - A relative path:   exotest .worktrees/fix-prompt-scroll
#   - An absolute path:  exotest /home/.../Exocortex/.worktrees/fix-prompt-scroll
#
# Starts the worktree's daemon (if not already running), launches the TUI,
# and kills the daemon when the TUI exits.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=./worktree-common.sh
source "$SCRIPT_DIR/worktree-common.sh"
# exotest is intentionally runnable from either the main checkout's script or
# the worktree's copy. Shared artifacts must always come from the common/main
# checkout; otherwise a worktree script would replace node_modules/.bun with a
# self-referential symlink before launching the instance.
COMMON_GIT_DIR="$(git -C "$SCRIPT_DIR" rev-parse --path-format=absolute --git-common-dir)"
EXOCORTEX_ROOT="$(dirname "$COMMON_GIT_DIR")"
DAEMON_PID=""
DAEMON_RESTART_EXIT_CODE=75

cleanup() {
  if [[ -n "$DAEMON_PID" ]] && kill -0 "$DAEMON_PID" 2>/dev/null; then
    kill "$DAEMON_PID" 2>/dev/null
    wait "$DAEMON_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

# ── Resolve worktree ────────────────────────────────────────────────

INPUT="${1:-}"
WORKTREE_DIR="$(resolve_worktree_dir "$INPUT")"

[[ -d "$WORKTREE_DIR" ]]        || worktree_die "Not found: $WORKTREE_DIR"
[[ -d "$WORKTREE_DIR/daemon" ]] || worktree_die "No daemon/ in $WORKTREE_DIR"
[[ -d "$WORKTREE_DIR/tui" ]]    || worktree_die "No tui/ in $WORKTREE_DIR"

WT_NAME=$(basename "$WORKTREE_DIR")

echo ""
echo "  exotest — $WT_NAME"
echo "  $WORKTREE_DIR"
echo ""

# ── Dependencies ────────────────────────────────────────────────────

# Always run bun install — it's idempotent and fast (~200ms) when
# everything is resolved, and catches stale/partial node_modules.
sync_dependency_artifacts "$WORKTREE_DIR"
(cd "$WORKTREE_DIR" && bun install --silent)

# ── Shared local resources ──────────────────────────────────────────

sync_shared_secrets "$WORKTREE_DIR"
sync_external_tools "$WORKTREE_DIR"

# ── Daemon ──────────────────────────────────────────────────────────

CONFIG_DIR="$WORKTREE_DIR/config"
RUNTIME_DIR="$CONFIG_DIR/runtime/$WT_NAME"
PID_FILE="$RUNTIME_DIR/exocortexd.pid"
# Resolve through the same shared helper as the daemon and clients. Deep
# worktree paths exceed the Unix-domain socket limit and intentionally hash to
# /tmp; hardcoding the runtime-dir path makes exotest time out after a healthy
# daemon has already bound the fallback socket.
SOCKET="$(cd "$WORKTREE_DIR" && bun -e 'import { socketPath } from "./shared/src/paths"; process.stdout.write(socketPath())')"
LOG="$RUNTIME_DIR/exocortexd.log"

# Check if a daemon is already alive for this worktree
DAEMON_ALIVE=false
if [[ -f "$PID_FILE" ]]; then
  OLD_PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [[ -n "$OLD_PID" ]] && kill -0 "$OLD_PID" 2>/dev/null; then
    DAEMON_ALIVE=true
  fi
fi

if $DAEMON_ALIVE; then
  echo "  Daemon already running (pid $OLD_PID)"
else
  mkdir -p "$RUNTIME_DIR"
  # A previous test daemon can leave a stale unix socket behind after it exits.
  # If we let the readiness loop see that stale socket, the TUI may start while
  # the new daemon is still unlinking/rebinding it, producing connect ENOENT.
  rm -f "$SOCKET"
  rm -f "$PID_FILE"

  echo "  Starting daemon (log: $LOG)"
  # Keep the test daemon under an instance-local supervisor. A restart request
  # exits only this worktree daemon with DAEMON_RESTART_EXIT_CODE; the supervisor
  # relaunches it without involving the user's main systemd service.
  (
    child_pid=""
    stop_child() {
      if [[ -n "$child_pid" ]] && kill -0 "$child_pid" 2>/dev/null; then
        kill "$child_pid" 2>/dev/null || true
        wait "$child_pid" 2>/dev/null || true
      fi
      exit 0
    }
    trap stop_child TERM INT HUP

    while true; do
      set +e
      (cd "$WORKTREE_DIR/daemon" && exec bun run src/main.ts >>"$LOG" 2>&1) &
      child_pid=$!
      wait "$child_pid"
      status=$?
      child_pid=""
      set -e
      [[ "$status" -eq "$DAEMON_RESTART_EXIT_CODE" ]] || exit "$status"
      printf '  exotest: restarting daemon instance %s\n' "$WT_NAME" >>"$LOG"
    done
  ) &
  DAEMON_PID=$!

  # Wait for the new socket to appear (up to 5s)
  for _ in $(seq 1 50); do
    [[ -S "$SOCKET" ]] && break
    # Bail early if the daemon process died
    kill -0 "$DAEMON_PID" 2>/dev/null || worktree_die "Daemon exited early (check $LOG)"
    sleep 0.1
  done
  [[ -S "$SOCKET" ]] || worktree_die "Daemon socket didn't appear after 5s (check $LOG)"
  sleep 0.2  # brief grace period between socket bind and listen

  echo "  Daemon ready (pid $DAEMON_PID)"
fi

echo ""

# ── TUI ─────────────────────────────────────────────────────────────

(cd "$WORKTREE_DIR/tui" && exec bun run src/main.ts)
